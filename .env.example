# Database Configuration (for Spring Boot)
DB_URL=jdbc:mysql://localhost:3306/mydatabase
DB_USERNAME=tu-usuario-mysql
DB_PASSWORD=tu-password-mysql

# MySQL Docker Configuration (for docker-compose)
MYSQL_DATABASE=mydatabase
MYSQL_USER=myuser
MYSQL_PASSWORD=your-mysql-password-here
MYSQL_ROOT_PASSWORD=your-root-password-here

# JWT Configuration
JWT_SECRET=genera-tu-secret-key-aqui

# Server Configuration
SERVER_PORT=8080

# Spring profile. "demo" creates sample data on startup (docker compose uses it by default;
# leave the value empty to start with an empty database).
# SPRING_PROFILES_ACTIVE=demo

# Email Configuration (Gmail SMTP)
# IMPORTANTE: No uses tu contraseña real de Gmail
# Usa "App Password": https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-password-generado